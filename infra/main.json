{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.43.8.12551",
      "templateHash": "10154671068501946889"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "koreacentral",
      "metadata": {
        "description": "Deployment region"
      }
    },
    "resourceGroupName": {
      "type": "string",
      "defaultValue": "rg-habitquest",
      "metadata": {
        "description": "Resource group name"
      }
    },
    "staticWebAppName": {
      "type": "string",
      "metadata": {
        "description": "Globally unique Static Web App name"
      }
    },
    "backendWebAppName": {
      "type": "string",
      "metadata": {
        "description": "Globally unique backend Web App name"
      }
    },
    "databaseUrl": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Backend runtime application settings"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Resources/resourceGroups",
      "apiVersion": "2024-03-01",
      "name": "[parameters('resourceGroupName')]",
      "location": "[parameters('location')]"
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "habitquest-app",
      "resourceGroup": "[parameters('resourceGroupName')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "location": {
            "value": "[parameters('location')]"
          },
          "staticWebAppName": {
            "value": "[parameters('staticWebAppName')]"
          },
          "backendWebAppName": {
            "value": "[parameters('backendWebAppName')]"
          },
          "databaseUrl": {
            "value": "[parameters('databaseUrl')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.43.8.12551",
              "templateHash": "11267985862516719592"
            }
          },
          "parameters": {
            "location": {
              "type": "string"
            },
            "staticWebAppName": {
              "type": "string"
            },
            "backendWebAppName": {
              "type": "string"
            },
            "databaseUrl": {
              "type": "string"
            }
          },
          "resources": [
            {
              "type": "Microsoft.OperationalInsights/workspaces",
              "apiVersion": "2023-09-01",
              "name": "[format('{0}-logs', parameters('backendWebAppName'))]",
              "location": "[parameters('location')]",
              "properties": {
                "retentionInDays": 30,
                "features": {
                  "enableLogAccessUsingOnlyResourcePermissions": true
                }
              }
            },
            {
              "type": "Microsoft.Insights/components",
              "apiVersion": "2020-02-02",
              "name": "[format('{0}-insights', parameters('backendWebAppName'))]",
              "location": "[parameters('location')]",
              "kind": "web",
              "properties": {
                "Application_Type": "web",
                "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('backendWebAppName')))]",
                "DisableIpMasking": false
              },
              "dependsOn": [
                "[resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('backendWebAppName')))]"
              ]
            },
            {
              "type": "Microsoft.Web/serverfarms",
              "apiVersion": "2023-12-01",
              "name": "[format('{0}-plan', parameters('backendWebAppName'))]",
              "location": "[parameters('location')]",
              "sku": {
                "name": "B1",
                "tier": "Basic"
              },
              "kind": "linux",
              "properties": {
                "reserved": true
              }
            },
            {
              "type": "Microsoft.Web/sites",
              "apiVersion": "2023-12-01",
              "name": "[parameters('backendWebAppName')]",
              "location": "[parameters('location')]",
              "kind": "app,linux,container",
              "identity": {
                "type": "SystemAssigned"
              },
              "properties": {
                "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', format('{0}-plan', parameters('backendWebAppName')))]",
                "httpsOnly": true,
                "siteConfig": {
                  "linuxFxVersion": "NODE|20-lts",
                  "minTlsVersion": "1.2",
                  "ftpsState": "Disabled",
                  "http20Enabled": true,
                  "alwaysOn": true,
                  "appSettings": [
                    {
                      "name": "NODE_ENV",
                      "value": "production"
                    },
                    {
                      "name": "PORT",
                      "value": "8080"
                    },
                    {
                      "name": "FRONTEND_URL",
                      "value": "[format('https://{0}.azurestaticapps.net', parameters('staticWebAppName'))]"
                    },
                    {
                      "name": "DATABASE_URL",
                      "value": "[parameters('databaseUrl')]"
                    },
                    {
                      "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                      "value": "[reference(resourceId('Microsoft.Insights/components', format('{0}-insights', parameters('backendWebAppName'))), '2020-02-02').ConnectionString]"
                    }
                  ]
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.Insights/components', format('{0}-insights', parameters('backendWebAppName')))]",
                "[resourceId('Microsoft.Web/serverfarms', format('{0}-plan', parameters('backendWebAppName')))]"
              ]
            },
            {
              "type": "Microsoft.Web/staticSites",
              "apiVersion": "2023-12-01",
              "name": "[parameters('staticWebAppName')]",
              "location": "centralus",
              "sku": {
                "name": "Free",
                "tier": "Free"
              },
              "properties": {
                "stagingEnvironmentPolicy": "Enabled",
                "allowConfigFileUpdates": true
              }
            }
          ],
          "outputs": {
            "frontendUrl": {
              "type": "string",
              "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/staticSites', parameters('staticWebAppName')), '2023-12-01').defaultHostname)]"
            },
            "backendUrl": {
              "type": "string",
              "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', parameters('backendWebAppName')), '2023-12-01').defaultHostName)]"
            }
          }
        }
      },
      "dependsOn": [
        "[subscriptionResourceId('Microsoft.Resources/resourceGroups', parameters('resourceGroupName'))]"
      ]
    }
  ],
  "outputs": {
    "resourceGroupName": {
      "type": "string",
      "value": "[parameters('resourceGroupName')]"
    },
    "frontendUrl": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'habitquest-app'), '2025-04-01').outputs.frontendUrl.value]"
    },
    "backendUrl": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'habitquest-app'), '2025-04-01').outputs.backendUrl.value]"
    }
  }
}