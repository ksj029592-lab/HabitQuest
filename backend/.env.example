# 환경 변수 설정 파일
# 복사: cp .env.example .env 후 수정

# 데이터베이스
DATABASE_URL="postgresql://user:password@localhost:5432/habitquest_dev"

# 서버
PORT=3001
FRONTEND_URL=http://localhost:3000

# 환경
NODE_ENV=development

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRATION=7d

# Foundry Model Router. Restrict deployment routing.models to GPT-5.4/5.5/5.6.
# The proposed deployment below must be provisioned before use.
FOUNDRY_MODEL_ROUTER_ENDPOINT=https://habitquestai50887.openai.azure.com/
FOUNDRY_MODEL_ROUTER_DEPLOYMENT=habitquest-model-router
# Empty uses DefaultAzureCredential (local Azure CLI login or managed identity).
FOUNDRY_MODEL_ROUTER_API_KEY=
